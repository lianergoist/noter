<?xml version="1.0" encoding="utf-8"?>
<!-- Serveren er sandheden. Database og indstillinger (med krypteret adgangskode, hvis nøgle
     ikke følger med) tages ikke med i backup; efter en gendannelse logger man ind og synkroniserer. -->
<full-backup-content>
    <exclude domain="database" path="." />
    <exclude domain="file" path="datastore/" />
    <exclude domain="sharedpref" path="." />
</full-backup-content>
